# ==============================================================================
# SecureMailScope Gateway — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ==============================================================================

# --- Server ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/securemailscope

# --- JWT ---
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_EXPIRES_IN=24h

# --- Django Analysis Service ---
DJANGO_BASE_URL=http://localhost:8000
DJANGO_INTERNAL_KEY=change-me-to-a-shared-internal-key
DJANGO_TIMEOUT_MS=120000

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIR=./uploads

# --- Mock Mode ---
# Set to "true" to use mock Django responses during development
USE_MOCK_DJANGO=true

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
